      },
      {
        "id": "creator",
        "workspace": "/home/sergiy_shyshko/.openclaw-content/src/workspaces/creator",
        "model": {
          "primary": "openai-codex/gpt-5.4-mini"
        }
      },
      {
        "id": "evaluator",
        "workspace": "/home/sergiy_shyshko/.openclaw-content/src/workspaces/evaluator",
        "model": {
          "primary": "openai-codex/gpt-5.4-mini"
        }
      },
      {
        "id": "publisher",
        "workspace": "/home/sergiy_shyshko/.openclaw-content/src/workspaces/publisher",
        "model": {
          "primary": "openai-codex/gpt-5.4-nano"
        }
      }
